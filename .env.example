# ---------------------------------------------------------------- Frontend
# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- Backend
# Signs login tokens. Set a long random value, or everyone is signed out on every restart.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a login lasts, in minutes (default 7 days)
# JWT_EXPIRE_MINUTES=10080

# Screen classifier: "stub" (no AI, scans are clean unless simulated from the Session page),
# "ollama" or "gemini"
AI_BACKEND=stub
# OLLAMA_HOST=http://172.26.144.1:11434
# GEMINI_API_KEY=

# Enables admin-only endpoints (create rewards, set points) via the X-Admin-Key header
# ADMIN_API_KEY=

# DATABASE_URL=sqlite:///./database.db
# CORS_ORIGINS=http://localhost:8080
# Login/signup rate limiting ("off" to disable, e.g. in tests)
# RATE_LIMITS=on
# LOG_LEVEL=INFO
